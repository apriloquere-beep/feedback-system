# Copy these values into the Apache/PHP process environment on the host.
# Do not commit a real .env file or any Gmail app password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-gmail-address@example.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_ADDRESS=your-gmail-address@example.com
MAIL_FROM_NAME=SFMS

# AES-256-GCM feedback encryption (Phase 1 foundation only).
# Generate the real key during the approved deployment phase; do not commit it.
# The key value must be Base64 encoding of exactly 32 cryptographically random bytes.
SFMS_AES_ACTIVE_KEY_ID=feedback-v1
SFMS_AES_KEY_FEEDBACK_V1=base64-encoded-32-byte-key-goes-here
