# Copy this file to .env on the hosting server, then replace every placeholder.
# Never commit the real .env file or share its passwords and encryption key.

# Online MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_online_database_name
DB_USER=your_online_database_username
DB_PASS=your_online_database_password

# Email delivery
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-gmail-address@example.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_ADDRESS=your-gmail-address@example.com
MAIL_FROM_NAME=SFMS

# AES-256-GCM feedback encryption
# Keep the same production key permanently or encrypted feedback cannot be read.
# The key value must be Base64 encoding of exactly 32 cryptographically random bytes.
SFMS_AES_ACTIVE_KEY_ID=feedback-v1
SFMS_AES_KEY_FEEDBACK_V1=base64-encoded-32-byte-key-goes-here
